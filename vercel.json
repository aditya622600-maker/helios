{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/apps/geolibre/experimental/kharghar-3d/index.html" },
    { "source": "/google-3d-test", "destination": "/apps/geolibre/experimental/google-3d-test/index.html" }
  ],
  "headers": [{ "source": "/apps/geolibre/experimental/kharghar-3d/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }]
}
